class RosCameraSubscriber(QObject):
    image_received = Signal(QImage)

    def __init__(self):
        super().__init__()


        self.bridge = CvBridge()

        self.node = rclpy.create_node("delta_camera_subscriber")

        self.subscription = self.node.create_subscription(Image, "/topic/name", self.image_callback, 10)

    def image_callback(self, msg):
        frame = self.bridge.imgmsg_to_cv2(msg,desired_encoding="bgr8")
        frame = cv2.cvtColor(frame,cv2.COLOR_BGR2RGB)

        height, width, channels = frame.shape
        bytes_per_line = channels * width

        image = QImage(frame.data, width, height, bytes_per_line, QImage.Format.Format_RGB888).copy()

        self.image_received.emit(image)

    def spin(self):
        rclpy.spin(self.node)

    def stop(self):
        self.node.destroy_node()

