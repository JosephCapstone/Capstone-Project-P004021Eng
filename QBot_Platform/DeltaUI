def launch_script(log):
    ssh=paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    log.appendPlainText("Connecting to D.E.L.T.A...")

    ssh.connect(
        hostname="192.168.0.157",
        username="nvidia",
        password="nvidia",
        )

    log.appendPlainText("Connected!")
    log.appendPlainText("Launching D.E.L.T.A...")

    ssh.exec_command("./run_qbot.sh")

    log.appendPlainText("D.E.L.T.A Launched!")

def stop_script(log):
    ssh=paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
        
    ssh.connect(
        hostname="192.168.0.157",
        username="nvidia",
        password="nvidia",
        )
        
    ssh.exec_command("pkill -INT -f [r]un_qbot.sh")

    ssh.close()

def start_recording(log, bag_recording_number):
    bag_num = bag_recording_number.text()

    ssh=paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    ssh.connect(
        hostname="192.168.0.157",
        username="nvidia",
        password="nvidia",
        )

    ssh.exec_command(f"nohup ~/run_record.sh {bag_num} &")

def stop_recording(log):
    ssh=paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

    ssh.connect(
        hostname="192.168.0.157",
        username="nvidia",
        password="nvidia",
        )

    ssh.exec_command("pkill -INT -f '[r]os2 bag record'")

    ssh.close()

