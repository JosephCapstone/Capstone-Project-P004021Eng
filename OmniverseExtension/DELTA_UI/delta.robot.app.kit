[package]
title = "DELTA"
description = "Isaac Sim damage inspection and PLY-to-USD application"
version = "0.5.0"

[dependencies]
"isaacsim.exp.base.python" = {}
"delta.robot.ui" = {}

[settings]
# DELTA uses local PLY/USD workflows; do not auto-start a ROS bridge.
isaac.startup.ros_bridge_extension = ""

[settings.app]
name = "DELTA"
version = "0.5.0"
settings.persistent = true

[settings.app.window]
title = "DELTA"
